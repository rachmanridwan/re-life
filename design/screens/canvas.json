ve":true},"TutFinale.dc.html":{"x":2350,"y":0,"w":390,"h":1000,"title":"Training complete — placement results","page":"tutorial","is_interactive":true},"Flow.dc.html":{"x":0,"y":0,"w":2240,"h":3584,"title":"End-to-end flow","page":"flow"},"FaceSetup.dc.html":{"x":0,"y":0,"w":390,"h":844,"title":"Face — choose scan or build","page":"avatar","is_interactive":true},"FaceScan.dc.html":{"x":470,"y":0,"w":390,"h":844,"title":"Face — guided scan","page":"avatar","is_interactive":true},"FaceAdjust.dc.html":{"x":940,"y":0,"w":390,"h":1180,"title":"Face — 3D editor (cel-shaded)","page":"avatar","is_interactive":true}},"order":["Main.dc.html","Breakdown.dc.html","Quests.dc.html","Treasury.dc.html","Log.dc.html","SkillDetail.dc.html","Welcome.dc.html","SignUp.dc.html","Login.dc.html","CreateCharacter.dc.html","EquipGear.dc.html","Reveal.dc.html","PrologueComplete.dc.html","Trial.dc.html","Focus.dc.html","Classes.dc.html","Achievements.dc.html","LevelUp.dc.html","NewHabit.dc.html","AddExpense.dc.html","Credentials.dc.html","PatchNotes.dc.html","Settings.dc.html","Components.dc.html","Icon.dc.html","TabBar.dc.html","TutMap.dc.html","TutIntro.dc.html","TutCoach.dc.html","TutChecklist.dc.html","TutReward.dc.html","TutFinale.dc.html","Flow.dc.html","FaceSetup.dc.html","FaceScan.dc.html","FaceAdjust.dc.html"],"notes":{"title":{"x":0,"y":-300,"text":"Core screens","kind":"title1","maxW":2740},"t_onb":{"x":0,"y":-300,"text":"Auth & onboarding (Prologue)","kind":"title1","maxW":3210,"page":"onboarding"},"t_feat":{"x":0,"y":-300,"text":"Features","kind":"title1","maxW":4620,"page":"features"},"t_comp":{"x":0,"y":-300,"text":"Components","kind":"title1","maxW":1750,"page":"components"},"s_TutMap":{"x":0,"y":1100,"text":"HUB. 6 short chapters, any order, ~10 min total; the whole tutorial fits in one sitting. Skippable (replay from Settings). Anything that needs real time (habit check tonight, a run outside) becomes a First Quest with no deadline.","w":390,"size":"m","fill":"orange","page":"tutorial"},"s_TutIntro":{"x":470,"y":1100,"text":"NARRATIVE BEAT. Future You (your Lv 99 self) explains WHY before the HOW. Max 2 short lines. One lesson per chapter, one action, one reward.","w":390,"size":"m","fill":"orange","page":"tutorial"},"s_TutCoach":{"x":940,"y":1100,"text":"TEACH IN PLACE. Spotlight on the real UI, not a slideshow. 3–4 steps max, always skippable. Lesson here: WIL only moves from verified habits.","w":390,"size":"m","fill":"orange","page":"tutorial"},"s_TutChecklist":{"x":1410,"y":1100,"text":"DO, DON'T READ. The chapter completes on the setup action. The real proof (first habit check tonight) moves to First Quests, so nothing blocks finishing today.","w":390,"size":"m","fill":"orange","page":"tutorial"},"s_TutReward":{"x":1880,"y":1100,"text":"PAYOFF. Cosmetic + Rested XP only, never free stats. Points straight to the next chapter: no waiting.","w":390,"size":"m","fill":"orange","page":"tutorial"},"s_TutFinale":{"x":2350,"y":1100,"text":"HANDOFF. Placement is computed instantly from imported history + today's Trial; no week of waiting. Rewards: Placed frame, Rested XP, and the 2x first-week XP boost starts.","w":390,"size":"m","fill":"orange","page":"tutorial"},"t_tut":{"x":0,"y":-300,"text":"Tutorial — Training (one sitting)","kind":"title1","maxW":2740,"page":"tutorial"},"t_avatar":{"x":0,"y":-300,"text":"Avatar & face scan (v2)","kind":"title1","maxW":1330,"page":"avatar"},"s_face1":{"x":0,"y":1140,"w":390,"size":"m","fill":"orange","page":"avatar","text":"Optional. Scan or build manually. Separate biometric consent (UU PDP) before any scan. Phones without Face ID: manual editor or photo-landmark fallback."},"s_face2":{"x":470,"y":1140,"w":390,"size":"m","fill":"orange","page":"avatar","text":"ARKit TrueDepth face mesh, 4 angles, ~20 s. Processed on device. Measures ~20 face-shape values + skin tone; nothing uploaded."},"s_face3":{"x":940,"y":1280,"w":390,"size":"m","fill":"orange","page":"avatar","text":"ART DIRECTION: 3D anime / game style, cel-shaded with ink outlines (not chibi, not photoreal). Live WebGL prototype: drag to rotate, sliders reshape the head. Procedural placeholder — final head is sculpted by an artist with the same slider set. HARD RULE: only slider values + choices are saved."}},"designSystems":[]}